source "https://rubygems.org"

# The github-pages gem pins Jekyll and all plugins to the exact versions that
# GitHub Pages runs in production, so a local build matches docs.sigrid-says.com.
# It also implicitly enables the plugins this site relies on (rendering Markdown
# without front matter, README as the index page, relative .md links, and the
# default layout), so _config.yml only has to list jekyll-redirect-from. That
# plugin is on the GitHub Pages allowlist, but only runs when listed there.
gem "github-pages", group: :jekyll_plugins
